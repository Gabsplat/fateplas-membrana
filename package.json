{
  "name": "fateplas-web",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@12.5.1",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 4320",
    "build": "next build",
    "build:pages": "node scripts/build-pages.mjs",
    "start": "next start --hostname 127.0.0.1 --port 4320",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "tsx --test src/lib/*.test.ts",
    "test:e2e": "playwright test",
    "format": "prettier --write src tests *.ts *.mjs *.json",
    "format:check": "prettier --check src tests *.ts *.mjs *.json"
  },
  "dependencies": {
    "motion": "^13.4.4",
    "next": "16.3.6",
    "nodemailer": "^7.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^7.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.3.6",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.9.0"
  }
}
